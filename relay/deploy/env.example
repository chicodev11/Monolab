# Copy to /etc/monolab-relay/env (owner root, mode 600). Never commit the real file.
# Discord Developer Portal → Monolab → OAuth2 → Client Secret.
MONOLAB_DISCORD_CLIENT_SECRET=
# Only to use a different Discord app than the built-in one (1572893457385783387).
#MONOLAB_DISCORD_CLIENT_ID=
# Who may open https://mnlab.cc/admin: Monolab account ids or permanent 8-digit numbers, comma-separated.
# (Handles aren't accepted: they can change hands.) Restart monolab-relay after changing it.
MONOLAB_ADMIN_USERS=
