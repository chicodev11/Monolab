  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sync": "node scripts/i18n-check.mjs --sync",
    "i18n:unused": "node scripts/i18n-unused.mjs",
    "css:prune": "node scripts/css-prune.mjs",
