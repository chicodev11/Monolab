    "build:fabric": "node scripts/build-fabric.mjs",
    "build:pumpkin": "node scripts/build-pumpkin.mjs",
    "build:addon": "npm run build:plugin && npm run build:mod && npm run build:fabric && npm run build:pumpkin",
    "notices": "node scripts/notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
