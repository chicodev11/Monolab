{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Monolab",
  "version": "1.6.1",
  "identifier": "com.monolab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Monolab",
        "width": 1500,
        "height": 950,
        "minWidth": 1180,
        "minHeight": 760,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/chicodev11/Monolab/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRkVFRjZDQjA3NkMyODMKUldTRHduYXdiTy8rcXhGb0lVMUdNeFpnN3hsTFI2Q1haQXZHTGN1SG5TTytWVkVPZzZLeHJNTGoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/*"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
